# Model provider configuration for `wakil query`.
# wakil reads these from the process environment (export them in your shell).

# Anthropic (default provider when set)
ANTHROPIC_API_KEY=

# Optional: override the model id (default: claude-opus-4-8 for Anthropic)
#WAKIL_MODEL=

# OpenAI-compatible endpoint (used when ANTHROPIC_API_KEY is unset,
# or when WAKIL_PROVIDER=openai). WAKIL_MODEL is required for this provider.
#OPENAI_API_KEY=
#WAKIL_OPENAI_BASE_URL=https://api.openai.com/v1
#WAKIL_PROVIDER=

# Optional: reasoning models only (gpt-5 and friends): minimal|low|medium|high.
# Sent verbatim when set; gpt-4.1/gpt-4o reject the parameter with a 400, so
# leave it unset for those. Reasoning tokens are billed against the same output
# budget; on a trivial prompt, minimal/low/medium produced zero of them. The
# effect on wakil's own structured enrichment calls is unmeasured — reasoning
# scales with the task, so don't assume a low effort prevents truncation there.
#WAKIL_REASONING_EFFORT=

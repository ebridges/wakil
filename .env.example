# Model provider configuration for `wakil query`.
# wakil reads these from the process environment (export them in your shell).

# Anthropic (default provider when set)
ANTHROPIC_API_KEY=

# Optional: override the model id (default: claude-opus-4-8 for Anthropic)
#WAKIL_MODEL=

# OpenAI-compatible endpoint (used when ANTHROPIC_API_KEY is unset,
# or when WAKIL_PROVIDER=openai). WAKIL_MODEL is required for this provider.
#OPENAI_API_KEY=
#WAKIL_OPENAI_BASE_URL=https://api.openai.com/v1
#WAKIL_PROVIDER=

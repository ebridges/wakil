{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "wakil: init",
      "type": "debugpy",
      "request": "launch",
      "module": "wakil.cli.main",
      "args": [
        "init",
        "${input:wakilInitPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "wakil: status",
      "type": "debugpy",
      "request": "launch",

  ],
  "inputs": [
    {
      "id": "wakilWorkspace",
      "type": "promptString",
      "description": "Workspace directory or registered workspace name",
      "default": "."
    },
    {
      "id": "wakilInitPath",
      "type": "promptString",
      "description": "Knowledge-base directory to initialize",
      "default": "."
    },
    {
      "id": "wakilSearchQuery",
      "type": "promptString",
      "description": "Free-text search query",
      "default": ""
    },
    {
      "id": "wakilQueryQuestion",
      "type": "promptString",
      "description": "Question to answer from the knowledge base",
      "default": ""
    },
    {
      "id": "wakilSourceId",
      "type": "promptString",
      "description": "Source id from the capture step",
      "default": "1"
    },
    {
      "id": "wakilTranscriptFile",
      "type": "promptString",
      "description": "Transcript file (.txt, .md, or .srt)",
      "default": ""
    },
    {
      "id": "wakilTextFile",
      "type": "promptString",
      "description": "Text or Markdown file to ingest",
      "default": ""
    },
    {
      "id": "wakilArticleUrl",
      "type": "promptString",
      "description": "Web article URL",
      "default": "https://"
    },
    {
      "id": "wakilMemoryId",
      "type": "promptString",
      "description": "Memory id (see wakil memory list)",
      "default": "1"
    },
    {
      "id": "wakilGitHistoryPath",
      "type": "promptString",
      "description": "Workspace-relative file path",
      "default": ""
    },
    {
      "id": "wakilSkillName",
      "type": "promptString",
      "description": "Skill name",
      "default": ""
    }
  ]
}